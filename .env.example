# Vorlage für die lokale Datei .env
# Die echte .env wird nie committet. Alle Werte hier sind Platzhalter.

# Datenbank
POSTGRES_DB=soforthilfe
POSTGRES_USER=soforthilfe
POSTGRES_PASSWORD=<starkes-passwort-setzen>

# Anmeldung (JWT)
JWT_KEY=<zufallswert-mit-mindestens-32-zeichen>
JWT_ISSUER=soforthilfe
JWT_AUDIENCE=soforthilfe

# Sprachmodell (Ollama, nur als Rückfall in der Verständniskette)
OLLAMA_BASE_URL=http://ollama:11434

# Alarmierung per Telegram
TELEGRAM_BOT_TOKEN=<token-des-bots>
TELEGRAM_CHAT_ID=<chat-id>

# E-Mail-Benachrichtigung (optional)
SMTP_HOST=<smtp-server>
SMTP_PORT=587
SMTP_USER=<benutzer>
SMTP_PASSWORD=<passwort>
SMTP_FROM=<absender-adresse>
