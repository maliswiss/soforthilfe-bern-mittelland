# Vorlage für die lokale Datei .env
# Die echte .env wird nie committet. Alle Werte hier sind Platzhalter.

# Datenbank (PostgreSQL mit PostGIS)
# POSTGRES_PORT ist der Port auf dem eigenen Rechner; bei einem belegten Port zum Beispiel 5433 wählen.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=soforthilfe
POSTGRES_USER=soforthilfe
POSTGRES_PASSWORD=<starkes-passwort-setzen>

# Containerplattform (docker compose --profile plattform up -d --build)
# Ports auf dem eigenen Rechner; bei belegten Ports andere Werte wählen.
HTTP_PORT=80
HTTPS_PORT=443
LASTVERTEILER_DASHBOARD_PORT=8081

# Testdaten mit fiktiven Personen beim Start laden (nur Entwicklung und Tests)
Testdaten__Laden=false
# Passwort für alle fiktiven Testkonten (mindestens 10 Zeichen); ohne Wert ist keine Anmeldung mit Testkonten möglich
TESTDATEN_PASSWORT=<testpasswort-setzen>

# Anmeldung (JWT)
JWT_KEY=<zufallswert-mit-mindestens-32-zeichen>
JWT_ISSUER=soforthilfe
JWT_AUDIENCE=soforthilfe

# Sprachmodell (Ollama, nur als Rückfall in der Verständniskette)
OLLAMA_BASE_URL=http://ollama:11434

# Alarmierung per Telegram
TELEGRAM_BOT_TOKEN=<token-des-bots>
TELEGRAM_CHAT_ID=<chat-id>

# E-Mail-Benachrichtigung (optional)
SMTP_HOST=<smtp-server>
SMTP_PORT=587
SMTP_USER=<benutzer>
SMTP_PASSWORD=<passwort>
SMTP_FROM=<absender-adresse>
